"""
Snakemake workflow for APSIM batch processing.

This workflow:
  1. Runs each batch CSV through APSIM using --apply + --batch
  2. Checks completeness by querying .db files against expected simulations
  3. Optionally merges all .db files into one

Usage:
    # Generate batch CSVs first
    python generate_batches.py

    # Run locally (for testing)
    snakemake --cores 4

    # Run on SLURM cluster
    snakemake --profile slurm --jobs 10
"""

import os
from pathlib import Path

import yaml

# ---------------------------------------------------------------------------
# Load configuration
# ---------------------------------------------------------------------------
with open("config.yaml", "r") as f:
    CONFIG = yaml.safe_load(f)

BATCH_DIR = CONFIG.get("output_dir", "batches")
DB_OUTPUT_DIR = CONFIG.get("db_output_dir", "OutputDatabases")
CONTAINER = CONFIG.get("container_image", "apsim.aimg")
APPTAINER_BIND = CONFIG.get("apptainer_bind", "")
APSIMX_TEMPLATE = CONFIG.get("apsimx_template", "LargerExample.apsimx")
COMMAND_TEMPLATE = "command_template.txt"
LOG_DIR = CONFIG.get("slurm", {}).get("log_dir", "slurmlogs")

# Discover batch files from the manifest (generated by generate_batches.py)
MANIFEST = os.path.join(BATCH_DIR, "batch_manifest.txt")
if os.path.exists(MANIFEST):
    with open(MANIFEST) as f:
        BATCH_FILES = [line.strip() for line in f if line.strip()]
    BATCH_IDS = [Path(bf).stem for bf in BATCH_FILES]
else:
    BATCH_FILES = sorted(Path(BATCH_DIR).glob("batch_*.csv"))
    BATCH_IDS = [bf.stem for bf in BATCH_FILES]
    BATCH_FILES = [str(bf) for bf in BATCH_FILES]

# ---------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------

rule all:
    """Final target: run all batches and validate completeness."""
    input:
        expand("{db_dir}/{batch_id}.db", db_dir=DB_OUTPUT_DIR, batch_id=BATCH_IDS),
        os.path.join(DB_OUTPUT_DIR, "validation_report.csv"),


rule run_batch:
    """
    Run a single batch CSV through APSIM.

    1. Copies the base .apsimx to {batch_id}.apsimx
    2. Runs: Models --apply command_template.txt --batch {batch_id}.csv
       - Each CSV row loads {batch_id}.apsimx, modifies soil/weather, and runs.
       - All simulation results accumulate in {batch_id}.db.
    3. Moves {batch_id}.db to the output directory.
    4. Cleans up the temporary {batch_id}.apsimx copy.
    """
    input:
        batch_csv=os.path.join(BATCH_DIR, "{batch_id}.csv"),
        command_template=COMMAND_TEMPLATE,
        apsimx_template=APSIMX_TEMPLATE,
    output:
        done=os.path.join(BATCH_DIR, "{batch_id}.done"),
        db=os.path.join(DB_OUTPUT_DIR, "{batch_id}.db"),
    log:
        os.path.join(LOG_DIR, "{batch_id}.log"),
    params:
        container=CONTAINER,
        bind=f"--bind {APPTAINER_BIND}" if APPTAINER_BIND else "",
        cpus=CONFIG.get("slurm", {}).get("cpus_per_task", 12),
    resources:
        time=CONFIG.get("slurm", {}).get("time", "02:00:00"),
        mem_mb=int(CONFIG.get("slurm", {}).get("mem", "8G").rstrip("GgMm")) * (
            1024 if "G" in CONFIG.get("slurm", {}).get("mem", "8G") else 1
        ),
        cpus_per_task=CONFIG.get("slurm", {}).get("cpus_per_task", 12),
        partition=CONFIG.get("slurm", {}).get("partition", ""),
    shell:
        """
        mkdir -p {LOG_DIR} {DB_OUTPUT_DIR}
        echo "Starting batch: {wildcards.batch_id}" | tee {log}
        echo "Timestamp: $(date)" | tee -a {log}
        echo "Working directory: $(pwd)" | tee -a {log}
        echo "Hostname: $(hostname)" | tee -a {log}

        # Copy base .apsimx to a batch-specific name so the .db is named per-batch
        cp {input.apsimx_template} {wildcards.batch_id}.apsimx

        # Create batch-local copies and strip CRLF (avoids race condition
        # when multiple jobs run sed -i on the shared command_template.txt)
        cp {input.command_template} {wildcards.batch_id}_command.txt
        sed -i 's/\r$//' {input.batch_csv} {wildcards.batch_id}_command.txt

        echo "--- Debug: command template contents ---" | tee -a {log}
        cat {wildcards.batch_id}_command.txt | tee -a {log}
        echo "--- Debug: batch CSV head ---" | tee -a {log}
        head -3 {input.batch_csv} | tee -a {log}
        echo "--- Debug: files in working dir ---" | tee -a {log}
        ls -la {wildcards.batch_id}.apsimx {wildcards.batch_id}_command.txt {input.batch_csv} 2>&1 | tee -a {log}
        echo "--- Debug: soil library check ---" | tee -a {log}
        ls -la 2026-03-10_SoilLibrary_r8012.apsimx 2>&1 | tee -a {log}
        echo "---" | tee -a {log}

        # Translate host path to container path (e.g. /mnt/gpfs/scratch → /agr/scratch)
        # and set --pwd so APSIM finds files in the working directory inside the container.
        CONTAINER_PWD=$(pwd | sed 's|^/mnt/gpfs/scratch|/agr/scratch|; s|^/mnt/gpfs/persist|/agr/persist|')

        echo "Command: apptainer exec --pwd $CONTAINER_PWD {params.bind} {params.container} Models --apply {wildcards.batch_id}_command.txt --batch {input.batch_csv} --cpu-count {params.cpus}" | tee -a {log}

        apptainer exec --pwd "$CONTAINER_PWD" {params.bind} {params.container} Models \
            --apply {wildcards.batch_id}_command.txt \
            --batch {input.batch_csv} \
            --cpu-count {params.cpus} \
            2>&1 | tee -a {log}

        exit_code=${{PIPESTATUS[0]}}
        echo "Exit code: $exit_code" | tee -a {log}
        echo "Finished: $(date)" | tee -a {log}

        # Move the .db to the output directory
        if [ -f "{wildcards.batch_id}.db" ]; then
            mv {wildcards.batch_id}.db {output.db}
            echo "Output: {output.db}" | tee -a {log}
        else
            echo "ERROR: {wildcards.batch_id}.db not found - APSIM failed" | tee -a {log}
            exit 1
        fi

        touch {output.done}

        # Clean up temporary batch-specific files
        rm -f {wildcards.batch_id}.apsimx {wildcards.batch_id}_command.txt
        """


rule validate_results:
    """
    After all batches complete, query each .db to check which
    simulations ran successfully vs. which are missing.
    Compares simulation names found in .db files against expected
    sim-name values from the batch CSVs.
    """
    input:
        expand("{db_dir}/{batch_id}.db", db_dir=DB_OUTPUT_DIR, batch_id=BATCH_IDS),
    output:
        report=os.path.join(DB_OUTPUT_DIR, "validation_report.csv"),
    params:
        batch_dir=BATCH_DIR,
        db_dir=DB_OUTPUT_DIR,
    resources:
        time="00:10:00",
        mem_mb=4000,
        cpus_per_task=1,
    run:
        import csv
        import sqlite3

        # Collect expected sim names per batch
        expected = {}  # {batch_id: [sim_name, ...]}
        for csv_file in sorted(Path(params.batch_dir).glob("batch_*.csv")):
            batch_id = csv_file.stem
            with open(csv_file, newline="") as f:
                reader = csv.DictReader(f)
                expected[batch_id] = [row["sim-name"] for row in reader]

        # Query each .db for completed simulations
        results = []  # [(sim_name, batch_id, status, sim_count)]
        total_expected = 0
        total_found = 0

        for batch_id, sim_names in sorted(expected.items()):
            db_path = Path(params.db_dir) / f"{batch_id}.db"
            found_sims = set()

            if db_path.exists() and db_path.stat().st_size > 0:
                try:
                    conn = sqlite3.connect(str(db_path))
                    cursor = conn.execute(
                        "SELECT DISTINCT Name FROM _Simulations"
                    )
                    found_sims = {row[0] for row in cursor.fetchall()}
                    conn.close()
                except sqlite3.Error as e:
                    print(f"  WARNING: Could not read {db_path}: {e}")

            for sim_name in sim_names:
                total_expected += 1
                # Experiment factorial expands sim-name into multiple
                # simulations prefixed with the sim-name, so check
                # if any simulation name starts with this prefix.
                matching = [s for s in found_sims if s.startswith(sim_name)]
                if matching:
                    results.append((sim_name, batch_id, "COMPLETED", len(matching)))
                    total_found += 1
                else:
                    results.append((sim_name, batch_id, "MISSING", 0))

        # Write report CSV
        with open(str(output.report), "w", newline="") as f:
            writer = csv.writer(f)
            writer.writerow(["sim_name", "batch_id", "status", "sim_count"])
            for row in results:
                writer.writerow(row)

        # Print summary
        missing = total_expected - total_found
        summary = (
            f"\nValidation summary:\n"
            f"  Expected:  {total_expected} simulations\n"
            f"  Completed: {total_found}\n"
            f"  Missing:   {missing}\n"
        )
        print(summary)

        with open(str(Path(params.db_dir) / "validation_summary.txt"), "w") as f:
            f.write(summary)

        if missing > 0:
            print(f"  See {output.report} for details.")


rule merge_databases:
    """
    Optional: merge all batch .db files into a single database.
    Run manually: snakemake merge_databases
    """
    input:
        expand("{db_dir}/{batch_id}.db", db_dir=DB_OUTPUT_DIR, batch_id=BATCH_IDS),
    output:
        os.path.join(DB_OUTPUT_DIR, "merged_results.db"),
    params:
        container=CONTAINER,
        bind=f"--bind {APPTAINER_BIND}" if APPTAINER_BIND else "",
        db_dir=DB_OUTPUT_DIR,
    resources:
        time="01:00:00",
        mem_mb=8000,
        cpus_per_task=1,
    shell:
        """
        db_files=$(find {params.db_dir} -maxdepth 1 -name "batch_*.db" -size +0c | tr '\\n' ' ')
        if [ -n "$db_files" ]; then
            apptainer exec {params.bind} {params.container} Models \
                --merge-db-files $db_files \
                2>&1
            # Move the merged file to the output location
            first_db=$(find {params.db_dir} -maxdepth 1 -name "batch_*.db" -size +0c | head -1)
            if [ -f "$first_db" ]; then
                cp "$first_db" {output}
            fi
        else
            echo "No batch .db files found to merge"
            touch {output}
        fi
        """


# ---------------------------------------------------------------------------
# Utility rules (run manually with: snakemake <rule_name>)
# ---------------------------------------------------------------------------

rule list_simulations:
    """List all simulation names that would be generated (dry run check)."""
    run:
        import csv

        total = 0
        for bf in BATCH_FILES:
            with open(bf) as f:
                reader = csv.DictReader(f)
                for row in reader:
                    print(row.get("sim-name", "unknown"))
                    total += 1
        print(f"\nTotal simulations: {total}")


rule clean:
    """Remove all generated outputs (batch .done markers, logs, sorted DBs)."""
    shell:
        """
        rm -f {BATCH_DIR}/*.done
        rm -f {LOG_DIR}/*.log
        rm -rf {DB_OUTPUT_DIR}
        echo "Cleaned all outputs."
        """
